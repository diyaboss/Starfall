# Copy this file to .env and fill in values before running the server.
# The .env file is gitignored — never commit real values.

# Port the HTTP server listens on
PORT=3001

# URL of the frontend client — used for CORS origin allowlist
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Secret code that grants admin/host privileges when supplied at join
# Change this before every event. Keep it short and memorable.
ADMIN_CODE=starfall-admin

# Node environment: development | production
NODE_ENV=development
